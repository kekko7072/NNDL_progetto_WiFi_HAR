\citation{simclr}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Baseline single-antenna classification architecture (M.~Carraro), a faithful reproduction of the SHARP reduced-Inception module~(\cite  {sharp}, Fig.~4). Three parallel branches (max-pool / strided conv / three stacked convs) extract multi-scale Doppler features; the maps are concatenated ($1{+}5{+}9=15$), reduced to $3$ by a $1\times 1$ convolution, then flattened and classified by a dense layer with dropout ($128{,}535$ parameters). \texttt  {S2} denotes stride~2; every CONV is followed by a ReLU.}}{4}{}\protected@file@percent }
\newlabel{fig:baseline_arch}{{3}{4}{}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Baseline training. Left: cross-entropy loss; right: accuracy. Validation accuracy plateaus near $0.52$ while training accuracy keeps rising, i.e.\ the model overfits the single training set $S1$; early stopping halts training at epoch~13.}}{4}{}\protected@file@percent }
\newlabel{fig:curves}{{4}{4}{}{figure.4}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {\mbox  {V-B}2}Domain-randomization augmentations}{4}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{\numberline {\mbox  {V-B}3}Encoder and projection head}{4}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces A window (\emph  {left}) and two augmented views. Amplitude scaling and Gaussian noise change the texture; the circular time shift and the SpecAugment-style time/Doppler masks (dark bands) hide parts of the pattern, while the activity signature (the horizontal energy band) is preserved.}}{4}{}\protected@file@percent }
\newlabel{fig:aug}{{5}{4}{}{figure.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Contrastive encoder $f(\cdot )$; output sizes for a $1\times 340\times 100$ input. BN$+$ReLU follow every convolution; ``sN'' denotes stride~N (default stride~1). The pooling output is the $128$-d representation $h$.}}{4}{}\protected@file@percent }
\newlabel{tab:encoder}{{2}{4}{}{table.2}{}}
