\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Row-normalized confusion matrices on all unseen test environments. The contrastive model (b) reduces the low-motion $L\!\rightarrow \!E$ confusion and sharpens \emph  {running} relative to the baseline (a).}}{5}{}\protected@file@percent }
\newlabel{fig:cm}{{6}{5}{}{figure.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces t-SNE of the test embeddings learned by the SupCon encoder. \emph  {Left}, colored by activity: a low-motion lobe (\emph  {empty}, \emph  {sitting}) and a high-motion lobe (\emph  {jumping}, \emph  {running}, \emph  {walking}). \emph  {Right}, the same points colored by environment: the colors are mixed \emph  {inside} the structure, i.e.\ the representation is organized by \emph  {activity}, not by \emph  {environment}---the intended environment-invariance.}}{5}{}\protected@file@percent }
\newlabel{fig:tsne}{{7}{5}{}{figure.7}{}}
