\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Row-normalized confusion matrices on all unseen test environments, along the four milestones. The contrastive representation (b) softens the $L\!\rightarrow \!E$ confusion of the baseline (a); the sliding window (c) lifts every class; fusion (d) repairs the low-motion pair itself, $L$ going from $0.49$ to $0.71$ with the \emph  {same} weights.}}{6}{}\protected@file@percent }
\newlabel{fig:cm}{{2}{6}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces t-SNE of the SupCon test embeddings (sliding-window run). \emph  {Left}, by activity: a static region (\emph  {empty}, \emph  {sitting}) and a moving arc (\emph  {jumping}, \emph  {running}, \emph  {walking}). \emph  {Right}, the same points by environment: colors are mixed \emph  {inside} the structure, i.e.\ the space is organized by \emph  {activity}, not by \emph  {environment}.}}{6}{}\protected@file@percent }
\newlabel{fig:tsne}{{3}{6}{}{}{}}
