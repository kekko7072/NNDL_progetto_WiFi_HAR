\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Row-normalized confusion matrices on all unseen test environments, along the four milestones of Fig.~\ref {fig:perset}. The contrastive representation (b) softens the $L\!\rightarrow \!E$ confusion of the baseline (a); the sliding window (c) lifts every class; fusion (d) then repairs the low-motion pair itself, $L$ going from $0.50$ to $0.75$ correct with the \emph  {same} weights.}}{7}{}\protected@file@percent }
\newlabel{fig:cm}{{5}{7}{}{figure.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Per-set accuracy (\%), training on $S1$ and testing on the unseen sets, one run per column. Non-overlapping windows: baseline under the fast ($10^{-3}$) and slow ($10^{-4}$) schedules, SupCon linear probe, and fusion on the slow-schedule model. Sliding window (stride $30$): baseline, SupCon probe and fusion. Fusion always re-uses the weights of the baseline to its left. SHARP columns from~\cite  {sharp} (Tables~3 and~4).}}{7}{}\protected@file@percent }
\newlabel{tab:compare}{{2}{7}{}{table.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces t-SNE of the test embeddings of the SupCon encoder (sliding-window run). \emph  {Left}, colored by activity: a static region (\emph  {empty}, \emph  {sitting}) and a moving arc (\emph  {jumping}, \emph  {running}, \emph  {walking}). \emph  {Right}, the same points colored by environment: the colors are mixed \emph  {inside} the structure, i.e.\ the space is organized by \emph  {activity}, not by \emph  {environment}.}}{7}{}\protected@file@percent }
